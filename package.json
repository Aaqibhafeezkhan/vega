{
  "name": "vega",
  "productName": "Vega",
  "version": "0.1.0",
  "description": "Standalone personal music app: search, library, playlists, analytics, recommendations",
  "author": "Dhruv Harani",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run build:lyra && electron-vite dev",
    "build": "npm run build:lyra && electron-vite build",
    "start": "electron-vite preview",
    "dev:web": "npm run build:lyra && vite -c vite.web.config.ts",
    "build:web": "npm run build:lyra && vite build -c vite.web.config.ts",
    "serve:dist": "node scripts/serve-dist.mjs",
    "build:lyra": "vite build -c vite.lyra.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc -p lyra/tsconfig.json",
    "test": "vitest run && vitest run -c vitest.lyra.config.ts",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:rls-check": "node scripts/rls-check.mjs",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "dist:dir": "npm run build && electron-builder --win dir --publish never"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "framer-motion": "^14.6.0",
    "mp4-muxer": "^5.2.2",
    "music-metadata": "^12.3.2",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "homepage": "https://github.com/DhruvHarani1/vega",
  "build": {
    "appId": "dev.vega.app",
    "productName": "Vega",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vega",
      "artifactName": "Vega-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio",
      "icon": "build/icon.png"
    }
  }
}
