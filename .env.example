# Copy to .env and fill in. .env is gitignored.

# Client-side (public by design; data is protected by Row Level Security).
# Leave empty to run Vega without accounts/cloud sync.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Admin-only, used by scripts/ (migrations, tests). Never expose to the client.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=
