{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "skipLibCheck": true, "esModuleInterop": true, "types": ["vite/client"], "noEmit": true,
    "paths": { "@shared/*": ["./shared/*"], "@core/*": ["./core/*"], "@/*": ["./renderer/src/*"] }
  },
  "include": ["renderer/src/**/*", "core/**/*", "shared/**/*", "host/**/*"]
}
